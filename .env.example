# Deterministic preview. No cloud credentials needed.
# Demo attempts are browser-session scoped, in server memory, NOT durable.
USE_MOCK=true

# Recorded-answer UI: fixture text only; no speech recognition or Google audio calls.
# Raw WAV is sent to this app for validation; set AUTH_URL to the exact browser origin.
PRACTICE_TRANSCRIPTION_MODE=demo
ALLOW_LOCAL_TRANSCRIPTION=false
# Real transcription remains hard-disabled in this checkpoint, regardless of flags.

# Authentication and persistence can be tested without paid AI/database calls:
# PRACTICE_AUTH_MODE=google
# PRACTICE_STORAGE=memory
# Other modes: PRACTICE_AUTH_MODE=demo; PRACTICE_STORAGE=firestore (Google auth required).

# Optional login-free Gemini testing (LOCAL DEVELOPMENT ONLY):
# Bind server to localhost; never expose this mode through a tunnel.
# USE_MOCK=false
# ALLOW_LOCAL_GEMINI=true
# PRACTICE_AUTH_MODE=demo
# PRACTICE_STORAGE=memory
# AUTH_URL=http://localhost:3000
# GEMINI_API_KEY=
# GEMINI_EVALUATION_MODEL=gemini-3.8-flash
# Limit: 10 provider attempts per server process, one at a time, 4096 output tokens.
# Restart resets the counter. This is NOT a dollar cap or permission to spend.

# Real private practice: Auth.js + Google OAuth + existing Google Cloud Firestore.
# No Firebase project association or Firebase Auth configuration is required.
# USE_MOCK=false
# GOOGLE_CLOUD_PROJECT=echo-490312
# AUTH_URL=http://localhost:3000
# AUTH_SECRET=generate-a-random-secret-of-at-least-32-characters
# AUTH_GOOGLE_ID=your-web-oauth-client-id
# AUTH_GOOGLE_SECRET=your-web-oauth-client-secret
# PRACTICE_ALLOWED_EMAILS=your-google-account-email
# GEMINI_API_KEY=
# GEMINI_EVALUATION_MODEL=
# PRACTICE_DAILY_EVALUATIONS=20

# Local OAuth redirect URI: http://localhost:3000/api/auth/callback/google
# Hosted AUTH_URL must use HTTPS; add its /api/auth/callback/google URI in Google.
# Backend Firestore uses Application Default Credentials. Never commit private keys.
# Optional fixed demo signing secret (demo storage remains ephemeral):
# DEMO_SESSION_SECRET=

# Legacy voice demo only:
# GOOGLE_CLOUD_SPEECH_LOCATION=us
